From: Andrew Hunt <achunt@bellsouth.net>
Date: Wed, 24 Sep 2026 18:00:00 -0400
Subject: [PATCH] led_controller: drive bl_power as well as brightness

Writing 0 to the backlight's "brightness" does not blank the panel on bluejay
(Pixel 6a) - the backlight stays lit. The panel only turns off when bl_power is
set to 4 (FB_BLANK_POWERDOWN), and it will not come back on unless bl_power is
returned to 0 before a non-zero brightness is written.

So the two have to move in opposite orders: power up before writing a non-zero
brightness, and power down only after writing zero. Doing it the other way round
leaves the panel dark with a non-zero brightness value.

led_controller_get_state() needs the same treatment: a panel blanked through
bl_power keeps its last brightness value, so brightness alone reports it as
still on and the display state machine never believes it slept.

bl_power is optional - backlight_bl_power_path stays NULL where the device does
not expose the attribute - so this is a no-op on backlights without it.

This is half of the display-sleep fix on bluejay. The other half is
DisplayManager::isOnPuck() in luna-sysmgr returning true on this device, which
makes the state machine think the phone is docked on a charging puck and refuse
to blank at all; that one still has no source fix.

Upstream-Status: Pending
---
--- a/src/led_controller/led_controller.c
+++ b/src/led_controller/led_controller.c
@@ -38,6 +38,13 @@
 
 static gchar *backlight_max_brightness_path = NULL;
 static gchar *backlight_brightness_path = NULL;
+static gchar *backlight_bl_power_path = NULL;
+
+/* bl_power takes the FB_BLANK_* values from <linux/fb.h>. Defined here rather
+ * than including that header, which drags in a large kernel UAPI surface for
+ * two constants. */
+#define BACKLIGHT_POWER_ON  0   /* FB_BLANK_UNBLANK */
+#define BACKLIGHT_POWER_OFF 4   /* FB_BLANK_POWERDOWN */
 
 static gchar* backlight_device_by_type(struct udev *udev, struct udev_list_entry *devices, const char *type)
 {
@@ -129,6 +136,7 @@
 
     backlight_max_brightness_path = g_build_filename(backlight_path, "max_brightness", NULL);
     backlight_brightness_path = g_build_filename(backlight_path, "brightness", NULL);
+    backlight_bl_power_path = g_build_filename(backlight_path, "bl_power", NULL);
     g_free(backlight_path);
 
     *d = (nyx_device_t*)nyxDev;
@@ -150,6 +158,11 @@
         backlight_brightness_path = NULL;
     }
 
+    if (backlight_bl_power_path) {
+        g_free(backlight_bl_power_path);
+        backlight_bl_power_path = NULL;
+    }
+
     return NYX_ERROR_NONE;
 }
 
@@ -217,9 +230,26 @@
         if (effect.backlight.brightness_lcd >= 0)
             value = (int)((max_brightness * effect.backlight.brightness_lcd) / 100.0);
 
-        if (FileWriteInt(backlight_brightness_path, value) < 0) {
-            status = NYX_CALLBACK_STATUS_FAILED;
-            goto done;
+        /* bl_power has to move in the opposite order to brightness: powering
+         * up before writing a non-zero brightness, and down only after writing
+         * zero. The other way round leaves the panel dark with a non-zero
+         * brightness value. */
+        if (value > 0) {
+            if (backlight_bl_power_path)
+                FileWriteInt(backlight_bl_power_path, BACKLIGHT_POWER_ON);
+
+            if (FileWriteInt(backlight_brightness_path, value) < 0) {
+                status = NYX_CALLBACK_STATUS_FAILED;
+                goto done;
+            }
+        } else {
+            if (FileWriteInt(backlight_brightness_path, 0) < 0) {
+                status = NYX_CALLBACK_STATUS_FAILED;
+                goto done;
+            }
+
+            if (backlight_bl_power_path)
+                FileWriteInt(backlight_bl_power_path, BACKLIGHT_POWER_OFF);
         }
 
         break;
@@ -248,13 +278,20 @@
 nyx_error_t led_controller_get_state(nyx_device_handle_t handle, nyx_led_controller_led_t led, nyx_led_controller_state_t *state)
 {
     int brightness = 0;
+    int bl_power = BACKLIGHT_POWER_ON;
 
     switch (led) {
     case NYX_LED_CONTROLLER_BACKLIGHT_LEDS:
         if (FileGetInt(backlight_brightness_path, &brightness) < 0)
             return NYX_ERROR_DEVICE_UNAVAILABLE;
 
-        *state = brightness > 0 ? NYX_LED_CONTROLLER_STATE_ON : NYX_LED_CONTROLLER_STATE_OFF;
+        /* A panel blanked through bl_power keeps its last brightness value, so
+         * brightness alone reports it as still on. */
+        if (backlight_bl_power_path)
+            FileGetInt(backlight_bl_power_path, &bl_power);
+
+        *state = (brightness > 0 && bl_power == BACKLIGHT_POWER_ON)
+                 ? NYX_LED_CONTROLLER_STATE_ON : NYX_LED_CONTROLLER_STATE_OFF;
 
         return NYX_ERROR_NONE;
     default:
